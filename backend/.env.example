PORT=5000
NODE_ENV=development

# MongoDB connection string. Use local mongod for dev, MongoDB Atlas for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/ar-safety

# JWT secret used to sign auth tokens. Generate a long random string for production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public base URL of the certificate verification web page (used to build QR payload URLs)
VERIFY_BASE_URL=http://localhost:5173/verify

# Default admin account created by the seed script
SEED_ADMIN_WORKER_ID=ADMIN001
SEED_ADMIN_PASSWORD=Admin@12345
